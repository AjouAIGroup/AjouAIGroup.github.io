{
    "tabWidth": 4,
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSameLine": true,
    "embeddedLanguageFormatting": "off",
    "overrides":
        [
            {
                "files": ["*.json", "*.yml", "*.yaml"],
                "options": { "tabWidth": 2 },
            },
        ],
}
